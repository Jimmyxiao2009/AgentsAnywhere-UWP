<Application x:Class="AgentsAnywhere.Mobile.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" RequestedTheme="Dark">
 <Application.Resources>
  <!-- Accent brushes are replaced at startup with the user's system accent colour (App.ApplyAccent). -->
  <SolidColorBrush x:Key="AccentBrush" Color="#0078D7"/>
  <SolidColorBrush x:Key="AccentTextBrush" Color="#76B9ED"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#590078D7"/>
  <SolidColorBrush x:Key="PageBrush" Color="#000000"/>
  <SolidColorBrush x:Key="ChromeBrush" Color="#1F1F1F"/>
  <SolidColorBrush x:Key="ChromeLowBrush" Color="#171717"/>
  <SolidColorBrush x:Key="ChromeMidBrush" Color="#2B2B2B"/>
  <SolidColorBrush x:Key="CodeBrush" Color="#0C0C0C"/>
  <SolidColorBrush x:Key="LowBrush" Color="#333333"/>
  <SolidColorBrush x:Key="FaintBrush" Color="#666666"/>
  <SolidColorBrush x:Key="MidBrush" Color="#999999"/>
  <SolidColorBrush x:Key="SoftTextBrush" Color="#BDBDBD"/>
  <SolidColorBrush x:Key="ThinkBrush" Color="#B4A0FF"/>
  <SolidColorBrush x:Key="ThinkBorderBrush" Color="#8764B8"/>
  <SolidColorBrush x:Key="WarnBrush" Color="#FFB900"/>
  <SolidColorBrush x:Key="ErrBrush" Color="#E81123"/>
  <SolidColorBrush x:Key="ErrTextBrush" Color="#FF99A4"/>
  <SolidColorBrush x:Key="OkBrush" Color="#6CCB5F"/>
  <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="MonoFont">Consolas</FontFamily>

  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MidBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MidBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="12,22,12,6"/></Style>
  <Style x:Key="AppTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
  <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="Light"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
  <Style x:Key="Glyph" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>

  <!-- Flat list row: tap target used for settings, devices and the "me" pivot. -->
  <Style x:Key="RowButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/>
   <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="56"/>
  </Style>
  <Style x:Key="IconButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Width" Value="48"/><Setter Property="Height" Value="40"/><Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="FontSize" Value="18"/>
  </Style>
  <Style x:Key="AccentButton" TargetType="Button">
   <Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="MinWidth" Value="96"/>
  </Style>
 </Application.Resources>
</Application>
